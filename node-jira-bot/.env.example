# ==============================================================================
# CREDENCIALES COMPARTIDAS DE JIRA CLOUD (COMUNES A TODOS LOS PROYECTOS)
# ==============================================================================
# Ejemplo: https://mi-organizacion.atlassian.net
JIRA_HOST=https://tu-organizacion.atlassian.net

# Tu correo electrónico asociado a la cuenta de Atlassian
JIRA_USER_EMAIL=tu-email@dominio.com

# API Token generado desde: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=tu_jira_api_token_aqui

# ==============================================================================
# CONFIGURACIÓN POR PROYECTO
# ==============================================================================
# Cada proyecto tiene su propia carpeta bajo projects/<nombre>/ con:
#   - .env       (JIRA_PROJECT_KEY y tipos de issue específicos)
#   - backlog.json
#
# Las credenciales de arriba (HOST, EMAIL, TOKEN) se comparten entre todos.
# Para usar un proyecto:  pnpm run dev <nombre>
# Ejemplo:                pnpm run dev cgs
# ==============================================================================

