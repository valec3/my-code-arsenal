# ============================================================
# Credenciales compartidas de Jira Cloud
# Copia este archivo a .env y reemplaza TODOS los valores.
# Este .env vive en la raiz de jira-seiri/.
# ============================================================

# URL base de tu sitio, sin barra final.
# Ejemplo: https://miempresa.atlassian.net
JIRA_HOST=https://your-domain.atlassian.net

# Email de la cuenta de Atlassian que genero el API token.
JIRA_USER_EMAIL=you@example.com

# API token (no es tu contrasena).
# Genera uno en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Opcional: id del campo de story points de tu instancia.
# Si no lo conoces, deja esta linea comentada y se omiten los story points.
# JIRA_STORY_POINTS_FIELD=customfield_10016
